.build/
build/
.DS_Store
__pycache__/

# Media never enters the public repository, except the bundled packs (demo, and the featured pack the owner approved
# for bundling on 2026-11-15 after confirming its rights).
*.mp4
*.m4v
*.mov
*.webm
*.mkv
!demo-pack/*.mp4
!demo-pack/*.m4v
!demo-pack/*.mov
!featured-pack/*.mp4
!featured-pack/*.mov
# The built-in Welcome's silent CC0 compatibility backgrounds (greeting-pack/NOTICE.md).
!greeting-pack/*.mp4

# Isolated sandbox-safe build and verification output.
.work/

# Local check logs that contain machine paths
checks/p003/
checks/p004/
checks/p007/
checks/p0*-verify.log

# P-008 author-check logs and generated review artifacts.
checks/p008/
checks/unit-tests.log
# Per-phase local check logs (contain machine paths)
checks/p0*/
