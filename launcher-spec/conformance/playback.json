      "event": "segmentEnded",
      "segment": "intro"
     },
     "expect": [
      {
       "command": "play",
       "segment": "loop",
       "looping": true
      }
     ]
    },
    {
     "event": {
      "event": "loopCycleEnded"
     },
     "expect": []
    },
    {
     "event": {
      "event": "windowReady"
     },
     "expect": [
      {
       "command": "moveToTargetWindow",
       "animated": true
      }
     ]
    },
    {
     "event": {
      "event": "windowReady"
     },
     "expect": []
    },
    {
     "event": {
      "event": "loopCycleEnded"
     },
     "expect": [
      {
       "command": "play",
       "segment": "outro",
       "looping": false
